{
  "name": "@substancelabs/deploy",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "deploy:bridge": "NODE_NO_WARNINGS=1 node --loader ts-node/esm src/deploy-bridge.ts",
    "deploy:tokens": "NODE_NO_WARNINGS=1 node --loader ts-node/esm src/deploy-tokens.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md,ts}\""
  },
  "author": "Substance Labs",
  "license": "MIT",
  "dependencies": {
    "@aztec/accounts": "3.0.0-devnet.6-patch.1",
    "@aztec/aztec.js": "3.0.0-devnet.6-patch.1",
    "@aztec/kv-store": "3.0.0-devnet.6-patch.1",
    "@aztec/pxe": "3.0.0-devnet.6-patch.1",
    "@aztec/stdlib": "3.0.0-devnet.6-patch.1",
    "@defi-wonderland/aztec-standards": "3.0.0-devnet.6-patch.1",
    "dotenv": "^16.4.7",
    "viem": "^2.23.11",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "resolutions": {
    "@aztec/foundation": "3.0.0-devnet.6-patch.1"
  }
}
