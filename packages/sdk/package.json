{
  "name": "@substancelabs/aztec-evm-bridge-sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "TypeScript SDK for bridging assets between Aztec and EVM chains using ERC-7683",
  "license": "MIT",
  "author": "Substance Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/substance-labs/aztec-evm-bridge.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "aztec",
    "evm",
    "bridge",
    "erc7683",
    "crosschain",
    "intent",
    "sdk"
  ],
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rm -rf dist",
    "format": "prettier --write \"**/*.{json,ts}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "yarn test:unit",
    "test:unit": "vitest run test/Bridge.unit.test.ts && vitest run --config vitest.browser.config.ts test/Bridge.unit.browser.test.ts",
    "test:e2e": "vitest run test/Bridge.e2e.test.ts && vitest run --config vitest.browser.config.ts test/Bridge.e2e.browser.test.ts",
    "test:all": "yarn test:node && yarn test:browser",
    "test:node": "yarn test:node:unit && yarn test:node:e2e",
    "test:node:unit": "vitest run test/Bridge.unit.test.ts",
    "test:node:e2e": "vitest run test/Bridge.e2e.test.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:unit": "vitest run --config vitest.browser.config.ts test/unit/browser/bridge-init.browser.test.ts test/unit/browser/order-data.browser.test.ts",
    "test:browser:e2e": "vitest run --config vitest.browser.config.ts test/Bridge.e2e.browser.test.ts",
    "test:browser:watch": "vitest --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage && vitest run --config vitest.browser.config.ts --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@azguardwallet/client": "0.7.0",
    "@aztec/accounts": "3.0.0-devnet.6-patch.1",
    "@aztec/aztec.js": "3.0.0-devnet.6-patch.1",
    "@aztec/foundation": "3.0.0-devnet.6-patch.1",
    "@aztec/kv-store": "3.0.0-devnet.6-patch.1",
    "@aztec/noir-contracts.js": "3.0.0-devnet.6-patch.1",
    "@aztec/pxe": "3.0.0-devnet.6-patch.1",
    "@aztec/stdlib": "3.0.0-devnet.6-patch.1",
    "@defi-wonderland/aztec-standards": "3.0.0-devnet.6-patch.1",
    "viem": "^2.33.2"
  },
  "devDependencies": {
    "@azguardwallet/types": "0.7.0",
    "@types/node": "^24.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/browser": "4.0.12",
    "@vitest/browser-playwright": "4.0.12",
    "@vitest/coverage-v8": "4.0.12",
    "dotenv": "^17.2.1",
    "eslint": "^9.22.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^5.4.11",
    "vite-plugin-node-polyfills": "^0.21.0",
    "vite-plugin-top-level-await": "^1.4.2",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "4.0.12"
  }
}
